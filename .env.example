# ==============================================================================
# SchoolDesk ERP Environment Variables (Supabase Connection)
# Institution: Mother Teresa Nobles Academy (Barmer) - Code: 1040211
# ==============================================================================

# 1. Your Supabase Project URL (From Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anonymous Public Key (Safe for client browsers)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Your Supabase Service Role Secret Key (Server-only / Elevated operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Session signing secret (REQUIRED for login). Use a random string >= 32 chars.
#    Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# 5. Optional: Database Direct Connection String (PostgreSQL Port 5432 / 6543)
# DATABASE_URL=postgresql://postgres.your-project-id:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 6. Hosting (Render/Vercel): the backend address. /api/* is passed through to it,
#    so the login cookie stays first-party. Leave NEXT_PUBLIC_API_URL EMPTY in production.
# BACKEND_URL=https://sms-barmer-backend.onrender.com
