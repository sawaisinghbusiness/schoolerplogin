# Express backend origin used by Next's same-origin /api forwarding.
BACKEND_URL=http://localhost:4000

# Leave empty for first-party forwarding (recommended).
# Set only for an intentionally separate browser API origin with matching CORS/cookies.
NEXT_PUBLIC_API_URL=

# Optional isolated production output while next dev uses .next.
# NEXT_DIST_DIR=.next-build

# Database service credentials and SESSION_SECRET belong to the backend deployment,
# not this frontend's NEXT_PUBLIC environment variables.
